{
  // Terminal > Run Task...
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "-q"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Test report (TEST_REPORT.md)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/make_test_report.py", "--live"],
      "problemMatcher": []
    },
    {
      "label": "Build EXE and installer",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/build_release.py"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Fetch APFS test images (needs internet, once)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/fetch_test_images.py"],
      "problemMatcher": []
    }
  ]
}
